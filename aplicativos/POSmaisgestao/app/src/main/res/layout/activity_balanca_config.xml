<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/balanca_config_titulo"
            android:textColor="@color/foreground"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtBalancaConfigStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/muted_foreground" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchBalancaHabilitada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="56dp"
            android:text="@string/balanca_habilitada"
            android:textColor="@color/foreground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/balanca_dispositivo"
            android:textColor="@color/foreground"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/listaDispositivosBalanca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/txtSemDispositivosBalanca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/balanca_sem_dispositivo"
            android:textColor="@color/muted_foreground"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAtualizarBalanca"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/atualizar_dispositivos" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/balanca_avancado"
            android:textColor="@color/foreground"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/balanca_protocolo_prt3"
            android:textColor="@color/foreground" />

        <Spinner
            android:id="@+id/spinnerBalancaBaud"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:contentDescription="@string/balanca_baud_rate" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/balanca_serial_8n1"
            android:textColor="@color/muted_foreground" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchBalancaLogHex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/balanca_log_hex"
            android:textColor="@color/foreground" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestarBalanca"
            style="@style/PosBigButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/balanca_testar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiagnosticoBalanca"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/balanca_abrir_diagnostico" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoltarBalanca"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/voltar" />
    </LinearLayout>
</ScrollView>
