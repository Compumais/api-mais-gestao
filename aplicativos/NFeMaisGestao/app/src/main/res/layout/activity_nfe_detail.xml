<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/headerBleed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy_primary">

        <LinearLayout
            android:id="@+id/headerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/header_padding_bottom">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/detalhe_nfe"
                android:textAppearance="@style/TextAppearance.NFe.HeaderTitle" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_content_sheet"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding_horizontal">

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:id="@+id/textDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_spacing"
                android:background="@drawable/bg_card_item"
                android:padding="12dp"
                android:textIsSelectable="true" />

            <CheckBox
                android:id="@+id/checkConfirmarProducao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/confirmar_producao" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDanfe"
                style="@style/Widget.NFe.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_spacing"
                android:text="@string/abrir_danfe" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTransmitir"
                style="@style/Widget.NFe.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_spacing"
                android:text="@string/transmitir" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.NFe.TextInput.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/justificativa">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputJustificativa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                style="@style/Widget.NFe.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_spacing"
                android:text="@string/cancelar_nfe" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInutilizar"
                style="@style/Widget.NFe.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_spacing"
                android:text="@string/inutilizar" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
