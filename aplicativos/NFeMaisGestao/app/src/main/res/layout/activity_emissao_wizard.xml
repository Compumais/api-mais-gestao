<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/headerBleed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy_primary">

        <LinearLayout
            android:id="@+id/headerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/header_padding_bottom">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wizard_titulo"
                android:textAppearance="@style/TextAppearance.NFe.HeaderSubtitle" />

            <TextView
                android:id="@+id/textStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.NFe.HeaderSubtitle" />

            <TextView
                android:id="@+id/textStepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.NFe.HeaderTitle" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/wizardProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="8"
                app:indicatorColor="@color/surface_white"
                app:trackColor="#4DFFFFFF"
                app:trackCornerRadius="4dp" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:indeterminateTint="@color/surface_white"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_content_sheet">

        <ViewFlipper
            android:id="@+id/wizardFlipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 0 Contexto -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding_horizontal">

                    <TextView
                        style="@style/TextAppearance.NFe.FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ambiente SEFAZ" />

                    <TextView
                        android:id="@+id/textAmbiente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.NFe.FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/field_spacing"
                        android:text="@string/natureza_operacao" />

                    <Spinner
                        android:id="@+id/spinnerNatureza"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_card_item" />

                    <TextView
                        style="@style/TextAppearance.NFe.FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/field_spacing"
                        android:text="Série" />

                    <Spinner
                        android:id="@+id/spinnerSerie"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_card_item" />

                    <TextView
                        style="@style/TextAppearance.NFe.FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/field_spacing"
                        android:text="Presença do comprador" />

                    <Spinner
                        android:id="@+id/spinnerIndPres"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_card_item" />

                    <TextView
                        style="@style/TextAppearance.NFe.FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/field_spacing"
                        android:text="Destino da operação" />

                    <Spinner
                        android:id="@+id/spinnerIdDest"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_card_item" />
                </LinearLayout>
            </ScrollView>

            <!-- 1 Destinatário -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding_horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.NFe.TextInput.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/buscar_cliente">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputBuscaCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/textDestinatarioSelecionado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/field_spacing"
                    android:background="@drawable/bg_card_item"
                    android:padding="12dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listClientesWizard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/field_spacing"
                    android:layout_weight="1"
                    android:clipToPadding="false" />
            </LinearLayout>

            <!-- 2 Busca produtos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding_horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/buscar_produto_hint"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.NFe.TextInput.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/field_spacing"
                    android:hint="@string/buscar_produto">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputBuscaProdutoWizard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listProdutosWizard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/field_spacing"
                    android:layout_weight="1"
                    android:clipToPadding="false" />
            </LinearLayout>

            <!-- 3 Confirmação itens -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding_horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wizard_step_itens_conf"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />

                <TextView
                    android:id="@+id/textSemItens"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/field_spacing"
                    android:text="@string/sem_itens"
                    android:textColor="@color/muted_foreground"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listItensWizard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/field_spacing"
                    android:layout_weight="1"
                    android:clipToPadding="false" />
            </LinearLayout>

            <!-- 4 Tributos -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding_horizontal">

                    <TextView
                        android:id="@+id/textTributosStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/calculando_tributos"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/listTributosItens"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/field_spacing"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Totais fiscais"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />

                    <GridLayout
                        android:id="@+id/gridTotaisFiscais"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:columnCount="2" />

                    <TextView
                        android:id="@+id/textTotalNota"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_card_item"
                        android:padding="14dp"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textStyle="bold" />
                </LinearLayout>
            </ScrollView>

            <!-- 5 Pagamento -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding_horizontal">

                    <TextView
                        style="@style/TextAppearance.NFe.FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/forma_nfe" />

                    <Spinner
                        android:id="@+id/spinnerPagamento"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_card_item" />

                    <TextView
                        style="@style/TextAppearance.NFe.FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/field_spacing"
                        android:text="@string/meio_pagamento_erp" />

                    <Spinner
                        android:id="@+id/spinnerTipoDocumento"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_card_item" />

                    <TextView
                        style="@style/TextAppearance.NFe.FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/field_spacing"
                        android:text="@string/condicao_pagamento" />

                    <Spinner
                        android:id="@+id/spinnerCondicaoPagamento"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_card_item" />

                    <TextView
                        style="@style/TextAppearance.NFe.FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/field_spacing"
                        android:text="@string/plano_contas" />

                    <Spinner
                        android:id="@+id/spinnerPlanoContas"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_card_item" />
                </LinearLayout>
            </ScrollView>

            <!-- 6 Transporte -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding_horizontal">

                    <TextView
                        style="@style/TextAppearance.NFe.FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Modalidade do frete" />

                    <Spinner
                        android:id="@+id/spinnerModFrete"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_card_item" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.NFe.TextInput.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/field_spacing"
                        android:hint="@string/valor_frete">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputValorFrete"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.NFe.TextInput.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/field_spacing"
                        android:hint="@string/valor_seguro">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputValorSeguro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.NFe.TextInput.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/field_spacing"
                        android:hint="@string/outras_despesas">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputOutrasDespesas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </ScrollView>

            <!-- 7 Revisão -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding_horizontal">

                    <CheckBox
                        android:id="@+id/checkConfirmarProducaoWizard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/confirmar_producao" />

                    <LinearLayout
                        android:id="@+id/revisaoContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/field_spacing"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSalvarRascunho"
                        style="@style/Widget.NFe.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/salvar_rascunho" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmitirNota"
                        style="@style/Widget.NFe.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/field_spacing"
                        android:text="@string/emitir_nfe" />
                </LinearLayout>
            </ScrollView>
        </ViewFlipper>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/wizardBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/bottom_bar_padding"
        android:paddingTop="@dimen/bottom_bar_padding"
        android:paddingBottom="@dimen/bottom_bar_padding">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWizardVoltar"
            style="@style/Widget.NFe.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/voltar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWizardAvancar"
            style="@style/Widget.NFe.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/field_spacing"
            android:layout_weight="1"
            android:text="@string/avancar" />
    </LinearLayout>
</LinearLayout>
