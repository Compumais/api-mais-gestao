{
	"name": "pdv-mais-gestao",
	"version": "0.1.0",
	"private": true,
	"description": "PDV Híbrido Desktop Mais Gestão (Electron + PostgreSQL local)",
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
		"build": "electron-vite build",
		"preview": "ELECTRON_DISABLE_SANDBOX=1 electron-vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
		"postinstall": "electron-builder install-app-deps",
		"pack:win": "npm run build && electron-builder --win"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.19",
		"lucide-react": "^0.577.0",
		"pg": "^8.16.3",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-router-dom": "^6.30.1",
		"tailwind-merge": "^3.4.0",
		"uuid": "^11.1.0",
		"zod": "^3.25.67"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.11",
		"@types/pg": "^8.15.5",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@types/uuid": "^10.0.0",
		"@vitejs/plugin-react": "^4.6.0",
		"electron": "^33.2.1",
		"electron-builder": "^25.1.8",
		"electron-vite": "^2.3.0",
		"tailwindcss": "^4.1.11",
		"typescript": "^5.8.3",
		"vite": "^5.4.19"
	},
	"engines": {
		"node": ">=20"
	},
	"build": {
		"appId": "com.maisgestao.pdv",
		"productName": "PDV Mais Gestão",
		"directories": {
			"output": "release"
		},
		"files": [
			"out/**/*",
			"package.json"
		],
		"win": {
			"target": [
				"nsis"
			]
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true
		}
	}
}
