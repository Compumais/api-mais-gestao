{
	"name": "pdv-mais-gestao",
	"version": "0.1.2",
	"private": true,
	"description": "PDV Híbrido Desktop Mais Gestão (Electron + PostgreSQL local)",
	"author": "Mais Gestão",
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
		"build": "electron-vite build",
		"preview": "ELECTRON_DISABLE_SANDBOX=1 electron-vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
		"test:tecnibra": "node ../api/node_modules/tsx/dist/cli.mjs --test electron/integracao/tecnibra/xml.test.ts electron/integracao/tecnibra/escrever.test.ts",
		"test:conta-gourmet": "node ../api/node_modules/tsx/dist/cli.mjs --test electron/db/conta-gourmet.test.ts",
		"test:pedido-entrega": "node ../api/node_modules/tsx/dist/cli.mjs --test electron/db/pedido-entrega.test.ts",
		"test:acesso": "node ../api/node_modules/tsx/dist/cli.mjs --test electron/db/acesso.test.ts",
		"test:sitef": "node ../api/node_modules/tsx/dist/cli.mjs --test electron/integracao/sitef/mapeamento.test.ts electron/integracao/sitef/servico.test.ts electron/impressora/cupom-pagamentos.test.ts",
		"test:balanca": "node ../api/node_modules/tsx/dist/cli.mjs --test electron/integracao/balanca/protocolo.test.ts electron/integracao/balanca/serial.test.ts electron/integracao/balanca/etiqueta.test.ts src/lib/produto-kg.test.ts",
		"test:pdv-secundario": "node ../api/node_modules/tsx/dist/cli.mjs --test electron/pdv-secundario/regras.test.ts",
		"test:xml": "node ../api/node_modules/tsx/dist/cli.mjs --test electron/fiscal/datas-xml-nfce.test.ts",
		"test:caixa": "node ../api/node_modules/tsx/dist/cli.mjs --test electron/db/resumo-turno-caixa.test.ts electron/impressora/comprovante-caixa.test.ts electron/impressora/danfce.test.ts",
		"test:teclas": "node ../api/node_modules/tsx/dist/cli.mjs --test src/lib/teclas-funcao.test.ts src/lib/pagamento-forma-nfe.test.ts src/lib/conta-gourmet.test.ts src/lib/observacao-pedido.test.ts electron/db/pagamento.test.ts",
		"test:producao": "node ../api/node_modules/tsx/dist/cli.mjs --test electron/impressora/producao.test.ts",
		"test:observacao": "node ../api/node_modules/tsx/dist/cli.mjs --test src/lib/observacao-item.test.ts",
		"postinstall": "electron-builder install-app-deps",
		"pack:win": "npm run build && electron-builder --win",
		"pack:dir": "npm run build && electron-builder --win --dir",
		"pack:iss": "npm run pack:dir && powershell -NoProfile -ExecutionPolicy Bypass -File installer/compilar-iss.ps1",
		"pack:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gerar-instalador.ps1"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@tanstack/react-table": "^8.21.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.19",
		"lucide-react": "^0.577.0",
		"pg": "^8.16.3",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-router-dom": "^6.30.1",
		"tailwind-merge": "^3.4.0",
		"uuid": "^11.1.0",
		"zod": "^3.25.67"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.11",
		"@types/pg": "^8.15.5",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@types/uuid": "^10.0.0",
		"@vitejs/plugin-react": "^4.6.0",
		"cross-env": "^10.1.0",
		"electron": "^33.2.1",
		"electron-builder": "^25.1.8",
		"electron-vite": "^2.3.0",
		"tailwindcss": "^4.1.11",
		"typescript": "^5.8.3",
		"vite": "^5.4.19"
	},
	"engines": {
		"node": ">=20"
	},
	"build": {
		"appId": "com.maisgestao.pdv",
		"productName": "PDV Mais Gestão",
		"copyright": "Copyright © Mais Gestão",
		"forceCodeSigning": false,
		"directories": {
			"output": "release"
		},
		"files": [
			"out/**/*",
			"package.json"
		],
		"win": {
			"signAndEditExecutable": false,
			"target": [
				"nsis"
			]
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"artifactName": "PDV-Mais-Gestao-Setup-${version}.${ext}",
			"unicode": true
		}
	}
}
