# Banco de dados de produção
DATABASE_URL=postgresql://mais_gestao:<PASSWORD>@127.0.0.1:5432/mais_gestao

# URL pública da API
API_URL=https://apimaisgestao.compumais.com

# URL pública do front-end (origem permitida no CORS e Better Auth)
FRONTEND_URL=https://maisgestao.compumais.com

# Alias legado do front-end (também aceito pelo CORS se FRONTEND_URL não estiver definido)
CLIENT_ORIGIN=https://maisgestao.compumais.com

# Origens CORS adicionais (separadas por vírgula)
CORS_ORIGINS=https://maisgestao.compumais.com,https://mais.compuchat.space

# Better Auth — URL pública da API
BETTER_AUTH_SECRET=<GERAR_COM_openssl_rand_base64_32>
BETTER_AUTH_URL=https://apimaisgestao.compumais.com
USE_SECURE_COOKIES=true

# Compartilha cookie de sessão entre api.* e o front (obrigatório com hosts diferentes)
COOKIE_DOMAIN=compumais.com

# OAuth Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Integração API Domínio / Onvio (credenciais do ERP homologado)
DOMINIO_CLIENT_ID=
DOMINIO_CLIENT_SECRET=

# Auto-update do PDV — pasta com version.json e Setup.exe (fallback se Nginx não servir /pdv/updates/)
PDV_UPDATES_PATH=/opt/mais-gestao/pdv-updates

# Diretório persistente das imagens de produtos
PRODUTO_IMAGENS_PATH=/opt/mais-gestao/produto-imagens

# IA gratuita do Mais Gestão (Ollama). Sem as duas variáveis, a IA usa a chave do usuário.
# A URL fica só no servidor. Pode ser a raiz ou já terminar em /v1.
# OLLAMA_BASE_URL=http://10.0.0.8:11434
# OLLAMA_MODEL=llama3.1

# Datadog APM (opcional — requer dd-trace na API e Agent no host)
# DD_ENV=prod
# DD_SERVICE=api-mais-gestao
# DD_VERSION=1.0.0
# DD_TRACE_ENABLED=true
# DD_LOGS_INJECTION=true
# DD_AGENT_HOST=host.docker.internal
