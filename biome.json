{
	"$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/dist",
			"!**/coverage",
			"!**/node_modules",
			"!**/.next",
			"!**/.next-staging",
			"!**/drizzle/meta",
			"!**/prismicio-types.d.ts",
			"!**/scripts/fix-servico-ids.*",
			"!**/*.sql",
			"!**/package-lock.json",
			"!**/pnpm-lock.yaml"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"noLabelWithoutControl": "off",
				"noStaticElementInteractions": "off",
				"useFocusableInteractive": "off",
				"useKeyWithClickEvents": "off",
				"useSemanticElements": "off"
			},
			"correctness": {
				"useExhaustiveDependencies": "warn",
				"useUniqueElementIds": "off"
			},
			"performance": {
				"noImgElement": "off"
			},
			"security": {
				"noDangerouslySetInnerHtml": "warn"
			},
			"suspicious": {
				"noArrayIndexKey": "warn",
				"noDoubleEquals": "warn",
				"noUnknownAtRules": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
